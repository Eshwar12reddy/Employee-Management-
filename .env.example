NODE_ENV=development
PORT=3001
DATABASE_URL=
SQLITE_PATH=data/candidates.sqlite
APP_ACCESS_KEY=replace-with-a-long-random-value
ALLOW_INSECURE_LOCAL=true
FRONTEND_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=4mb
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Frontend build-time setting; this is a URL, never a secret.
VITE_API_BASE_URL=/api
